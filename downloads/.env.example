# 米家智能插座3 + KS52 LoRa 温湿度传感器 配置文件
# 将此文件复制为 .env 并填入你的实际信息

# ===== 米家智能插座3 (cuco.plug.v3) =====
# 设备 IP 地址（与 ECM50 在同一局域网内）
DEVICE_IP=192.168.1.2

# 设备 Token（32位字符串，通过 Xiaomi-cloud-tokens-extractor 获取）
DEVICE_TOKEN=7f3982f998ec98809d3a887b30c8e63f

# 设备型号
DEVICE_MODEL=cuco.plug.v3

# ===== ECM50-A07 WiFi 配置（用于连接路由器，与插座同一局域网）=====
WIFI_SSID=CMCC-cQCN
WIFI_PASSWORD=CcWfpvPb

# ===== MQTT 配置（ECM50 上报数据用）=====
# Broker 地址（测试用 broker.emqx.io，生产环境改为后端提供的地址）
MQTT_BROKER=broker.emqx.io
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
# 设备 ID（用于构造 topic 和 client_id，每台 ECM50 唯一）
MQTT_DEVICE_ID=plug001

# ===== 智能插座采集周期（毫秒）=====
# 默认每 5 秒采集 / 上报一次插座数据
SOCKET_INTERVAL_MS=5000

# ===== KS52 LoRa 温湿度接入 =====
# ECM50-A07 的 LoRa 是 亿佰特私有透传，不能直接接收 KS52 的标准 LoRaWAN 报文。
# 用法：用同协议的 LoRa 节点（如亿佰特 E22/E220 系列 + SHT41 自制温湿度节点）
#       把 KS52 手册定义的 15 字节 payload 原样发给 ECM50，
#       ECM50 收到后按 KS52 协议解析并上报。
#
# LORA_DRIVER 可选值:
#   none   = 不启用 LoRa（只采集插座数据 + MQTT），默认值
#   uart   = 外接串口 LoRa 模块（E22/E220/E32 的 TX/RX 接 ESP32 UART）。推荐。
#   spi    = 板载/外接 SPI LoRa 芯片（SX1268/SX1278）。需要确认 ECM50 引脚。
LORA_DRIVER=none

# --- 当 LORA_DRIVER=uart 时，配置以下参数 ---
# ESP32 UART ID: ECM50-A07 的 USB 调试口已占用 UART0；
# 板载 RS485 占用 UART1/2（参考 ECM50 例程）。外置 LoRa 模块请用剩下的 UART。
LORA_UART_ID=1
# 留空则使用 UART 默认引脚。如要自定义请填 GPIO 号（整数），例如 LORA_UART_TX=4
LORA_UART_TX=
LORA_UART_RX=
LORA_UART_BAUD=9600
# 帧间隔（ms）：串口超过这个时间没收到新字节就认为一帧结束
LORA_UART_GAP_MS=150

# --- 当 LORA_DRIVER=spi 时，配置以下参数（请参考 ECM50 官方网盘例程填准确引脚）---
LORA_SPI_ID=2
LORA_SPI_SCK=
LORA_SPI_MOSI=
LORA_SPI_MISO=
LORA_SPI_CS=
LORA_SPI_BAUD=2000000
LORA_RESET=
LORA_DIO1=
LORA_SF=9
LORA_BW=125000
LORA_CR=8
# 工作频率（Hz）：中国常用 470.125 MHz；KS52 手册中的 CN470 对应
LORA_FREQ=470125000

# ===== ECM50 板载 AI 温湿度（本地直读，最快让 ECM50 读到温湿度）=====
# ECM50-A07 自带 2 路 4-20mA AI（12bit ADC，满量程=24mA），
# 直接接工业级"4-20mA 温湿度变送器"（两路：一路温度、一路湿度）
# CH0 默认接温度(-40~85°C), CH1 默认接湿度(0~100%RH)
# 变送器选型提示：供电 DC12~24V，输出 4-20mA（温度/湿度各占 1 路）
AI_ENABLE=false
# "current_4_20ma"（默认）|"voltage_0_10v"
AI_TYPE=current_4_20ma
# 温度通道 (CH0=ADC0)
AI_TEMP_CH=0
AI_TEMP_MIN=-40.0
AI_TEMP_MAX=85.0
# 湿度通道 (CH1=ADC1)
AI_RH_CH=1
AI_RH_MIN=0.0
AI_RH_MAX=100.0
# ADC 满量程 (12bit=4095)
AI_ADC_MAX=4095
# 4-20mA 模式下满量程电流值（ECM50-A07 默认硬件 FS=24mA）
AI_FS_MA=24.0
# 0-10V 模式下满量程电压（备用）
AI_FS_V=10.0

